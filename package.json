{
  "name": "git-runner-hub",
  "version": "1.0.0",
  "description": "1-Click GitHub Actions Self-Hosted Runner Manager for Windows & macOS — Zero Cloud CI Cost for Coding Agents",
  "main": "src/main/main.js",
  "author": "Bui The Long <buithelong@caevietnam.vn>",
  "license": "MIT",
  "homepage": "https://github.com/buithelong-all/git-runner-hub",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist:win": "electron-builder --win portable --dir",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.buithelong.gitrunnerhub",
    "productName": "GitRunnerHub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
